  "groups": [
    { "groupId": "er-001", "expectedMerge": true, "note": "legal suffix normalization (B.V. vs BV), exact reg+jur", "primary": { "sourceName": "opencorporates", "legalName": "Acme Logistics B.V.", "registrationNumber": "NL12345678", "jurisdiction": "NL" }, "secondary": { "sourceName": "complyadvantage", "legalName": "ACME LOGISTICS BV", "registrationNumber": "NL12345678", "jurisdiction": "NL" } },
