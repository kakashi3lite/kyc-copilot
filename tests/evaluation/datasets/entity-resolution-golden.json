    { "groupId": "er-023", "expectedMerge": false, "note": "same name+jurisdiction, different registration — must NOT merge without reg match (score 0.56 < 0.70)", "primary": { "sourceName": "opencorporates", "legalName": "Rheinland Metals GmbH", "registrationNumber": "DE-2002", "jurisdiction": "DE" }, "secondary": { "sourceName": "complyadvantage", "legalName": "Rheinland Metals GmbH", "registrationNumber": "DE-9999", "jurisdiction": "DE" } },
