# ── Build artifacts ──────────────────────────────────────
dist/
*.tsbuildinfo

# ── Dependencies ─────────────────────────────────────────
node_modules/

# ── Environment / secrets ────────────────────────────────
.env
.env.*
!.env.example

# ── IDE / OS ─────────────────────────────────────────────
.cursor/
.vscode/
.idea/
.DS_Store
*.swp
# macOS AppleDouble resource forks — break the Docker build context (xattr
# send errors) and pollute due-diligence exports. Always excluded.
._*

# ── Version control ──────────────────────────────────────
.git/
.gitignore

# ── Docs & CI (not needed in image) ─────────────────────
docs/
demo-logs/
scripts/
.github/
*.md
!README.md
# NOTE: `tests/` is intentionally NOT excluded — the `test` Docker stage
# (docker compose run --rm test) copies it. The runtime stage never copies
# tests/, so the production image stays lean.

# ── Docker recursion ─────────────────────────────────────
Dockerfile
docker-compose.yml
fly.toml

# ── Session & config artifacts ───────────────────────────
.session-state.yaml
# drizzle.config.ts is needed by the `test` Docker stage (`db:migrate`);
# the runtime image never copies it.
