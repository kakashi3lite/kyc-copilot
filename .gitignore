# Dependencies
node_modules/

# Build
dist/

# Environment / secrets
.env
.env.*
!.env.example

# Session handoff (per-session, not committed)
.session-state.yaml

# Evidence / screenshots
# Root-level transient captures stay ignored; the product screenshots that
# ship in the README/docs are committed under docs/screenshots/.
evidence/
screenshots/
*.png
*.jpg
!docs/screenshots/
!docs/screenshots/*.png
!docs/screenshots/*.jpg

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# TypeScript
*.tsbuildinfo

# Test coverage
coverage/

# Drizzle
drizzle/meta/
