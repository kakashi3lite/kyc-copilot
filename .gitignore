# Dependencies
node_modules/

# Build
dist/

# Environment / secrets
.env
.env.*
!.env.example

# Session handoff (per-session, not committed)
.session-state.yaml

# Evidence / screenshots
# Root-level transient captures stay ignored; the product screenshots that
# ship in the README/docs are committed under docs/screenshots/.
evidence/
screenshots/
*.png
*.jpg
!docs/screenshots/
!docs/screenshots/*.png
!docs/screenshots/*.jpg

# OS
.DS_Store
# macOS AppleDouble resource forks — leak into the repo on macOS and pollute
# source listings / due-diligence exports (verified present in src/ and tests/).
._*
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# TypeScript
*.tsbuildinfo

# Test coverage
coverage/

# Generated evaluation benchmark reports (regenerated by `npm run bench:*`)
tests/evaluation/reports/

# Drizzle
drizzle/meta/
